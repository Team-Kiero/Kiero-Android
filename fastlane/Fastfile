default_platform(:android)

platform :android do

  # 공통 배포 로직
  # 내부 테스트 빌드는 dev 서버를 바라보도록 고정 (프로덕션 배포 전 검증용)
  private_lane :distribute_flavor do |options|
    version = options[:version]
    environment = "dev"
    flavor = "#{version}#{environment.capitalize}"
    app_id = options[:app_id]

    gradle(
      tasks: ["clean", "assemble"],
      flavor: flavor,
      build_type: "Release"
    )

    firebase_app_distribution(
      app: app_id,
      android_artifact_type: "APK",
      android_artifact_path: "app/build/outputs/apk/#{flavor}/release/app-#{version}-#{environment}-release.apk",
      groups: "internal-testers",
      release_notes: "내부 테스트 빌드입니다.",
      service_credentials_file: ENV["FIREBASE_SERVICE_CREDENTIALS_PATH"] || "fastlane/firebase-service-account.json"
    )
  end

  desc "Parent 앱 Firebase 배포"
  lane :distribute_parent do
    distribute_flavor(version: "parent", app_id: ENV["FIREBASE_APP_ID_PARENT"])
  end

  desc "Child 앱 Firebase 배포"
  lane :distribute_child do
    distribute_flavor(version: "child", app_id: ENV["FIREBASE_APP_ID_CHILD"])
  end

  desc "두 앱 모두 배포"
  lane :distribute_all do
    distribute_parent
    distribute_child
  end

end